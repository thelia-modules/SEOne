{# ============ robots.txt configuration ============ #}
<div class="card mb-4">
    <div class="card-header">
        <h5 class="card-title mb-0">{{ 'Robots.txt'|trans({}, 'seone') }}</h5>
    </div>
    <div class="card-body">
        <div class="row">
            {% for robot_form in robot_forms %}
                <div class="col-md-6 mb-4">
                    {{ form_start(robot_form, {action: path('seone_config_edit_robottxt'), method: 'POST'}) }}
                        <input type="hidden" name="{{ robot_form.vars.full_name }}[success_url]" value="{{ path('admin.module.configure', {module_code: 'SEOne'}) }}">
                        <input type="hidden" name="{{ robot_form.vars.full_name }}[error_url]" value="{{ path('admin.module.configure', {module_code: 'SEOne'}) }}">
                        {% do robot_form.success_url.setRendered %}
                        {% do robot_form.error_url.setRendered %}

                        <input type="hidden" name="{{ robot_form.id.vars.full_name }}" value="{{ robot_form.id.vars.value }}">
                        {% do robot_form.id.setRendered %}

                        {{ form_errors(robot_form) }}

                        <div class="mb-3">
                            {{ form_label(robot_form.domainName) }}
                            {{ form_widget(robot_form.domainName, {attr: {class: 'form-control'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(robot_form.robotContent) }}
                            {{ form_widget(robot_form.robotContent, {attr: {class: 'form-control font-monospace', rows: 12}}) }}
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> {{ 'Save'|trans({}, 'seone') }}
                        </button>
                    {{ form_end(robot_form) }}
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{# Variable buttons and length counters of the meta template card. No library, no build step. #}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var card = document.getElementById('seone-meta-templates');

        if (!card) {
            return;
        }

        card.querySelectorAll('[data-seone-variable]').forEach(function (button) {
            button.addEventListener('click', function () {
                var input = document.getElementById(button.dataset.seoneTarget);

                if (!input) {
                    return;
                }

                var value = input.value;
                var start = null === input.selectionStart ? value.length : input.selectionStart;
                var end = null === input.selectionEnd ? value.length : input.selectionEnd;
                var before = value.slice(0, start);
                var insertion = button.dataset.seoneVariable;

                if (before.length > 0 && !/\s$/.test(before)) {
                    insertion = ' ' + insertion;
                }

                input.value = before + insertion + value.slice(end);

                var caret = before.length + insertion.length;

                input.focus();
                input.setSelectionRange(caret, caret);
                input.dispatchEvent(new Event('input', { bubbles: true }));
            });
        });

        card.querySelectorAll('[data-seone-counter-for]').forEach(function (counter) {
            var input = document.getElementById(counter.dataset.seoneCounterFor);

            if (!input) {
                return;
            }

            input.addEventListener('input', function () {
                counter.textContent = input.value.length + ' / ' + counter.dataset.seoneCounterMax;
            });
        });
    });
</script>
