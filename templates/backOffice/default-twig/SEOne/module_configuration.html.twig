{# ============ Store SEO configuration ============ #}
<div class="card mb-4" id="seone-store">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h5 class="card-title mb-0">{{ 'Configure Store'|trans({}, 'seone') }}</h5>
        {{ component('BoLanguageSwitcher', { currentLanguageId: store_edit_language_id }) }}
    </div>
    <div class="card-body">
        {% set store_return_url = path('admin.module.configure', {module_code: 'SEOne', edit_language_id: store_edit_language_id}) ~ '#seone-store' %}
        {{ form_start(store_form, {action: path('seone_config_store_configuration'), method: 'POST'}) }}
            <input type="hidden" name="edit_language_id" value="{{ store_edit_language_id }}">
            <input type="hidden" name="{{ store_form.vars.full_name }}[success_url]" value="{{ store_return_url }}">
            <input type="hidden" name="{{ store_form.vars.full_name }}[error_url]" value="{{ store_return_url }}">
            {% do store_form.success_url.setRendered %}
            {% do store_form.error_url.setRendered %}

            {{ form_errors(store_form) }}

            <div class="row">
                <div class="col-md-4 mb-3">
                    {{ form_label(store_form.title) }}
                    {{ form_widget(store_form.title, {attr: {class: 'form-control'}}) }}
                </div>
                <div class="col-md-4 mb-3">
                    {{ form_label(store_form.description) }}
                    {{ form_widget(store_form.description, {attr: {class: 'form-control'}}) }}
                </div>
                <div class="col-md-4 mb-3">
                    {{ form_label(store_form.keywords) }}
                    {{ form_widget(store_form.keywords, {attr: {class: 'form-control'}}) }}
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> {{ 'Save'|trans({}, 'seone.bo.default') }}
            </button>
        {{ form_end(store_form) }}
    </div>
</div>

{# ============ Meta tag templates ============ #}
<div class="card mb-4" id="seone-meta-templates"
     data-seone-preview-url="{{ path('seone_config_meta_templates_preview') }}"
     data-seone-preview-token="{{ meta_template_preview_token }}"
     data-seone-preview-language="{{ meta_template_edit_language_id }}"
     data-seone-preview-empty="{{ 'meta_template.preview.empty'|trans({}, 'seone') }}"
     data-seone-preview-unknown="{{ 'meta_template.preview.unknown'|trans({}, 'seone') }}"
     data-seone-example-record="{{ 'meta_template.example.record'|trans({}, 'seone') }}"
     data-seone-preview-failed="{{ 'meta_template.preview.error.generic'|trans({}, 'seone') }}">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h5 class="card-title mb-0">{{ 'meta_template.card.title'|trans({}, 'seone') }}</h5>
        {{ component('BoLanguageSwitcher', { currentLanguageId: meta_template_edit_language_id }) }}
    </div>
    <div class="card-body">
        {% set meta_template_return_url = path('admin.module.configure', {module_code: 'SEOne', edit_language_id: meta_template_edit_language_id}) ~ '#seone-meta-templates' %}
        {{ form_start(meta_template_form, {action: path('seone_config_meta_templates_configuration'), method: 'POST'}) }}
            <input type="hidden" name="edit_language_id" value="{{ meta_template_edit_language_id }}">
            <input type="hidden" name="{{ meta_template_form.vars.full_name }}[success_url]" value="{{ meta_template_return_url }}">
            <input type="hidden" name="{{ meta_template_form.vars.full_name }}[error_url]" value="{{ meta_template_return_url }}">
            {% do meta_template_form.success_url.setRendered %}
            {% do meta_template_form.error_url.setRendered %}

            {{ form_errors(meta_template_form) }}

            <p class="text-muted small mb-1">{{ 'meta_template.help'|trans({}, 'seone') }}</p>
            <p class="small mb-3" data-seone-priority>{{ 'meta_template.priority'|trans({}, 'seone') }}</p>

            <div class="row">
                <div class="col-md-3 mb-3">
                    {{ form_label(meta_template_form.max_length_title) }}
                    {{ form_widget(meta_template_form.max_length_title, {attr: {class: 'form-control'}}) }}
                </div>
                <div class="col-md-3 mb-3">
                    {{ form_label(meta_template_form.max_length_description) }}
                    {{ form_widget(meta_template_form.max_length_description, {attr: {class: 'form-control'}}) }}
                </div>
            </div>

            {% if meta_template_views is empty %}
                <p class="text-muted mb-3">{{ 'meta_template.empty'|trans({}, 'seone') }}</p>
            {% else %}
                <div class="accordion mb-3" id="seone-meta-templates-accordion">
                    {% for entry in meta_template_views %}
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="seone-meta-heading-{{ entry.view }}">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#seone-meta-collapse-{{ entry.view }}"
                                        aria-expanded="false"
                                        aria-controls="seone-meta-collapse-{{ entry.view }}">
                                    {# A page kind brought by another module has no label here: its name stands in. #}
                                    {% set view_label = ('meta_template.view.' ~ entry.view)|trans({}, 'seone') %}
                                    {{ view_label starts with 'meta_template.view.' ? entry.view|capitalize : view_label }}
                                </button>
                            </h2>
                            <div id="seone-meta-collapse-{{ entry.view }}"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="seone-meta-heading-{{ entry.view }}"
                                 data-bs-parent="#seone-meta-templates-accordion">
                                <div class="accordion-body">
                                    {% set example_label = entry.example_id is null ? null : entry.records[entry.example_id] %}
                                    <table class="table table-sm small align-middle mb-4" data-seone-examples="{{ entry.view }}">
                                        <caption class="caption-top pt-0" data-seone-example-record>
                                            {{- example_label is null
                                                ? 'meta_template.example.none'|trans({}, 'seone')
                                                : 'meta_template.example.record'|trans({'%record%': example_label}, 'seone') -}}
                                        </caption>
                                        <thead>
                                            <tr>
                                                <th scope="col">{{ 'meta_template.example.variable'|trans({}, 'seone') }}</th>
                                                <th scope="col">{{ 'meta_template.example.value'|trans({}, 'seone') }}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for variable in entry.variables %}
                                                {% set example_value = entry.example_values[variable] ?? '' %}
                                                <tr>
                                                    <td class="text-nowrap"><code>%{{ variable }}%</code></td>
                                                    <td data-seone-example-value="{{ variable }}">{{ example_value|length > 90 ? example_value|slice(0, 90) ~ '…' : example_value }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>

                                    {% for field_key in ['title', 'description'] %}
                                        {% set field = attribute(meta_template_form, entry.view ~ '_' ~ field_key) %}
                                        {% set max_length = attribute(meta_template_form, 'max_length_' ~ field_key).vars.value %}
                                        <div class="mb-4">
                                            {{ form_label(field) }}
                                            {{ form_widget(field, {attr: {class: 'form-control'}}) }}
                                            {% set template_length = field.vars.value|default('')|length %}
                                            <small class="d-block mt-1 {{ template_length > max_length ? 'text-danger fw-semibold' : 'text-muted' }}"
                                                   data-seone-counter-for="{{ field.vars.id }}"
                                                   data-seone-counter-max="{{ max_length }}"
                                                   data-seone-counter-max-input="{{ attribute(meta_template_form, 'max_length_' ~ field_key).vars.id }}">{{ template_length }} / {{ max_length }}</small>
                                            <div class="mt-2">
                                                <small class="text-muted d-block mb-1">{{ 'meta_template.variables'|trans({}, 'seone') }}</small>
                                                {% for variable in entry.variables %}
                                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1 mb-1"
                                                            data-seone-variable="%{{ variable }}%"
                                                            data-seone-target="{{ field.vars.id }}">{{ variable }}</button>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endfor %}

                                    {# Preview: the two templates above, saved or not, rendered by the server on a chosen record. #}
                                    <div class="border-top pt-3" data-seone-preview="{{ entry.view }}">
                                        <h6>{{ 'meta_template.preview.title'|trans({}, 'seone') }}</h6>
                                        <p class="text-muted small">{{ 'meta_template.preview.help'|trans({}, 'seone') }}</p>
                                        <div class="row g-2 align-items-end mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label" for="seone-preview-record-{{ entry.view }}">{{ 'meta_template.preview.record'|trans({}, 'seone') }}</label>
                                                <input type="text" inputmode="numeric" class="form-control"
                                                       id="seone-preview-record-{{ entry.view }}"
                                                       list="seone-preview-records-{{ entry.view }}"
                                                       value="{{ entry.example_id }}"
                                                       data-seone-preview-record>
                                                <datalist id="seone-preview-records-{{ entry.view }}">
                                                    {% for record_id, record_label in entry.records %}
                                                        <option value="{{ record_id }}">{{ record_label }}</option>
                                                    {% endfor %}
                                                </datalist>
                                            </div>
                                            <div class="col-auto">
                                                <button type="button" class="btn btn-outline-primary" data-seone-preview-run>
                                                    <i class="bi bi-eye"></i> {{ 'meta_template.preview.run'|trans({}, 'seone') }}
                                                </button>
                                            </div>
                                        </div>
                                        <div class="alert alert-danger py-2 small" role="alert" data-seone-preview-error hidden></div>
                                        <dl class="row small mb-0" data-seone-preview-result aria-live="polite" hidden>
                                            {% for field_key in ['title', 'description'] %}
                                                <dt class="col-sm-2">{{ ('meta_template.field.' ~ field_key)|trans({}, 'seone') }}</dt>
                                                <dd class="col-sm-10">
                                                    <span data-seone-preview-output="{{ field_key }}"></span>
                                                    <small class="d-block text-muted" data-seone-preview-length="{{ field_key }}"></small>
                                                    <small class="d-none text-warning-emphasis" data-seone-preview-unknown="{{ field_key }}"></small>
                                                </dd>
                                            {% endfor %}
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> {{ 'Save'|trans({}, 'seone.bo.default') }}
            </button>
        {{ form_end(meta_template_form) }}
    </div>
</div>

