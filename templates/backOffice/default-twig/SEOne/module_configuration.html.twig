{# ============ robots.txt configuration ============ #}
<div class="card mb-4">
    <div class="card-header">
        <h5 class="card-title mb-0">{{ 'Robots.txt'|trans({}, 'seone') }}</h5>
    </div>
    <div class="card-body">
        <div class="row">
            {% for robot_form in robot_forms %}
                <div class="col-md-6 mb-4">
                    {{ form_start(robot_form, {action: path('seone_config_edit_robottxt'), method: 'POST'}) }}
                        <input type="hidden" name="{{ robot_form.vars.full_name }}[success_url]" value="{{ path('admin.module.configure', {module_code: 'SEOne'}) }}">
                        <input type="hidden" name="{{ robot_form.vars.full_name }}[error_url]" value="{{ path('admin.module.configure', {module_code: 'SEOne'}) }}">
                        {% do robot_form.success_url.setRendered %}
                        {% do robot_form.error_url.setRendered %}

                        <input type="hidden" name="{{ robot_form.id.vars.full_name }}" value="{{ robot_form.id.vars.value }}">
                        {% do robot_form.id.setRendered %}

                        {{ form_errors(robot_form) }}

                        <div class="mb-3">
                            {{ form_label(robot_form.domainName) }}
                            {{ form_widget(robot_form.domainName, {attr: {class: 'form-control'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(robot_form.robotContent) }}
                            {{ form_widget(robot_form.robotContent, {attr: {class: 'form-control font-monospace', rows: 12}}) }}
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> {{ 'Save'|trans({}, 'seone') }}
                        </button>
                    {{ form_end(robot_form) }}
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{# Variable buttons, length counters and preview of the meta template card. No library, no build step. #}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var card = document.getElementById('seone-meta-templates');

        if (!card) {
            return;
        }

        card.querySelectorAll('[data-seone-variable]').forEach(function (button) {
            button.addEventListener('click', function () {
                var input = document.getElementById(button.dataset.seoneTarget);

                if (!input) {
                    return;
                }

                var value = input.value;
                var start = null === input.selectionStart ? value.length : input.selectionStart;
                var end = null === input.selectionEnd ? value.length : input.selectionEnd;
                var before = value.slice(0, start);
                var insertion = button.dataset.seoneVariable;

                if (before.length > 0 && !/\s$/.test(before)) {
                    insertion = ' ' + insertion;
                }

                input.value = before + insertion + value.slice(end);

                var caret = before.length + insertion.length;

                input.focus();
                input.setSelectionRange(caret, caret);
                input.dispatchEvent(new Event('input', { bubbles: true }));
            });
        });

        // The counter follows both the template and the maximum typed above it, before any save.
        var updateCounter = function (counter) {
            var input = document.getElementById(counter.dataset.seoneCounterFor);
            var maxInput = document.getElementById(counter.dataset.seoneCounterMaxInput);
            var max = parseInt(maxInput && '' !== maxInput.value ? maxInput.value : counter.dataset.seoneCounterMax, 10);

            if (!input || isNaN(max)) {
                return;
            }

            var exceeds = input.value.length > max;

            counter.textContent = input.value.length + ' / ' + max;
            // Bootstrap text utilities: red and bolder past the maximum, muted below it.
            counter.classList.toggle('text-danger', exceeds);
            counter.classList.toggle('fw-semibold', exceeds);
            counter.classList.toggle('text-muted', !exceeds);
        };

        card.querySelectorAll('[data-seone-counter-for]').forEach(function (counter) {
            [counter.dataset.seoneCounterFor, counter.dataset.seoneCounterMaxInput].forEach(function (id) {
                var watched = document.getElementById(id);

                if (watched) {
                    watched.addEventListener('input', function () {
                        updateCounter(counter);
                    });
                }
            });
        });

        var showPreview = function (block, data, fieldIds) {
            var result = block.querySelector('[data-seone-preview-result]');

            ['title', 'description'].forEach(function (field) {
                var answer = data.fields[field];
                var output = block.querySelector('[data-seone-preview-output="' + field + '"]');
                var length = block.querySelector('[data-seone-preview-length="' + field + '"]');
                var unknown = block.querySelector('[data-seone-preview-unknown="' + field + '"]');
                var maxInput = document.getElementById(fieldIds['max_length_' + field]);

                output.textContent = '' === answer.rendered ? card.dataset.seonePreviewEmpty : answer.rendered;
                output.classList.toggle('text-muted', '' === answer.rendered);
                length.textContent = answer.length + (maxInput && '' !== maxInput.value ? ' / ' + maxInput.value : '');
                unknown.textContent = card.dataset.seonePreviewUnknown.replace('%unknown%', answer.unknown.join(', '));
                unknown.classList.toggle('d-none', 0 === answer.unknown.length);
                unknown.classList.toggle('d-block', 0 !== answer.unknown.length);
            });

            var body = block.closest('.accordion-body');
            var option = body.querySelector('datalist option[value="' + data.id + '"]');

            body.querySelector('[data-seone-example-record]').textContent = card.dataset.seoneExampleRecord
                .replace('%record%', option ? option.textContent : '#' + data.id);

            body.querySelectorAll('[data-seone-example-value]').forEach(function (cell) {
                var value = data.values[cell.dataset.seoneExampleValue] || '';

                cell.textContent = value.length > 90 ? value.slice(0, 90) + '…' : value;
            });

            result.hidden = false;
        };

        card.querySelectorAll('[data-seone-preview]').forEach(function (block) {
            var view = block.dataset.seonePreview;
            var button = block.querySelector('[data-seone-preview-run]');
            var error = block.querySelector('[data-seone-preview-error]');
            var prefix = 'seone_meta_template_form_';
            var fieldIds = {
                title: prefix + view + '_title',
                description: prefix + view + '_description',
                max_length_title: prefix + 'max_length_title',
                max_length_description: prefix + 'max_length_description'
            };

            button.addEventListener('click', function () {
                var body = new FormData();

                body.append('_token', card.dataset.seonePreviewToken);
                body.append('edit_language_id', card.dataset.seonePreviewLanguage);
                body.append('view', view);
                body.append('id', block.querySelector('[data-seone-preview-record]').value.trim());

                Object.keys(fieldIds).forEach(function (name) {
                    var input = document.getElementById(fieldIds[name]);

                    body.append(name, input ? input.value : '');
                });

                error.hidden = true;
                button.disabled = true;

                fetch(card.dataset.seonePreviewUrl, {
                    method: 'POST',
                    body: body,
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(function (response) {
                        return response.json().catch(function () {
                            return { error: card.dataset.seonePreviewFailed };
                        });
                    })
                    .then(function (data) {
                        if (data.error || !data.fields) {
                            error.textContent = data.error || card.dataset.seonePreviewFailed;
                            error.hidden = false;
                            block.querySelector('[data-seone-preview-result]').hidden = true;

                            return;
                        }

                        showPreview(block, data, fieldIds);
                    })
                    .catch(function () {
                        error.textContent = card.dataset.seonePreviewFailed;
                        error.hidden = false;
                    })
                    .finally(function () {
                        button.disabled = false;
                    });
            });
        });
    });
</script>
